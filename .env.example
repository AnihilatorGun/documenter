GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Whose Drive stores the files. This account's refresh token is saved on first login.
OWNER_EMAIL=owner@example.com

# Who may log in. Comma-separated. OWNER_EMAIL is always allowed.
ALLOWED_EMAILS=second@example.com,third@example.com

# Random string; changing it logs everyone out.
SESSION_SECRET=change-me

# "local" keeps files in data/files, "drive" uploads to Google Drive.
STORAGE=local
DRIVE_FOLDER_NAME=Documenter

DB_PATH=data/documenter.db
LOCAL_FILES_DIR=data/files
BASE_URL=http://localhost:8000
